@using FleetlyWeb.Base
@using FleetlyWeb.Services.Users
@using Fleetly.Shared.Dto.UserDtos
@using Fleetly.Shared.Dto.UserDetailsDtos
@using FleetlyWeb.Helpers
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inherits DialogBase<UserUpdateDto>
@inject IUserService UserService

<MudDialog>
    <DialogContent>
        <EditForm Model="@Model" @ref="EditForm">
            <DataAnnotationsValidator />

            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Details.Name"
                                  For="@(() => Model.Details.Name)"
                                  Label="Imię"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Details.Surname"
                                  For="@(() => Model.Details.Surname)"
                                  Label="Nazwisko"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Email"
                                  For="@(() => Model.Email)"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputMode="InputMode.email"
                                  Placeholder="x@mail.com" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Model.Details.PhoneNumber"
                                  For="@(() => Model.Details.PhoneNumber)"
                                  Label="Numer telefonu"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  InputMode="InputMode.tel"
                                  Placeholder="123 456 789" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="Model.Details.Company"
                                  For="@(() => Model.Details.Company)"
                                  Label="Firma"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="IsBusy">Anuluj</MudButton>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="SubmitForm"
                   Disabled="IsBusy">
            @if (IsBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
            else
            {
                <MudText Typo="Typo.button">Zapisz</MudText>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private int _userId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsBusy = true;
            await LoadUserData();
            if (_userId == 0)
            {
                Snackbar.Add("Błąd autoryzacji: Nie znaleziono ID użytkownika.", Severity.Error);
                MudDialog.Cancel();
                return;
            }

            var result = await UserService.GetUserByIdAsync(_userId);

            if (result.Data != null && result.Success)
            {
                var User = result.Data;
                Model = new UserUpdateDto
                {
                    Email = User.Email,
                    RoleId = User.RoleId,
                    Details = new UserDetailsDto
                    {
                        Name = User.Details.Name,
                        Surname = User.Details.Surname,
                        PhoneNumber = User.Details.PhoneNumber,
                        Company = User.Details.Company
                    }
                };
            }
            else
            {
                Snackbar.Add("Nie udało się załadować danych użytkownika", Severity.Error);
                MudDialog.Cancel();
            }

        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił błąd podczas ładowania danych użytkownika", Severity.Error);
            MudDialog.Cancel();
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = ClaimsPrincipalHelper.GetUserId(authState.User);
    }

    protected override async Task Submit()
    {
        try
        {
            var response = await UserService.UpdateUserAsync(_userId, Model);

            if (response.Success)
            {
                Snackbar.Add("Profil zaktualizowany pomyślnie", Severity.Success);

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(response.Error ?? "Nie udało się zaktualizować profilu", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił błąd podczas aktualizacji profilu", Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }
}