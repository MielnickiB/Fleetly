<MudPaper Elevation="3" Class="@($"pa-4 d-flex flex-column align-center justify-center {ColorClass}")">
    <MudIcon Icon="@Icon" Size="Size.Large" />
    <MudText Typo="Typo.h4">@Value</MudText>
    <MudText Typo="Typo.subtitle1">@Title</MudText>
</MudPaper>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Value { get; set; } = "0";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Info;

    [Parameter] public string ColorClass { get; set; } = "";
}