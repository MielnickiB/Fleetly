@using FleetlyWeb.Helpers
@using FleetlyWeb.Services.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService Auth
@inject NavigationManager Nav

@code {
    private ClaimsPrincipal? User;
    private bool _isLoggingOut = false;

    protected override async Task OnInitializedAsync()
    {
        User = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
    }

    async Task LogoutAsync()
    {
        _isLoggingOut = true;
        try
        {
            await Auth.Logout();
            Nav.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoggingOut = false;
            StateHasChanged();
        }
    }
}

<MudNavMenu>

    <MudNavLink Href="/home" Icon="@Icons.Material.Filled.Home">Strona główna</MudNavLink>
    <MudNavLink Href="/vehicles" Icon="@Icons.Material.Filled.CarRental">Pojazdy</MudNavLink>
    <MudNavLink Href="/locations" Icon="@Icons.Material.Filled.LocationOn">Lokalizacje</MudNavLink>
    <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.ListAlt">Zlecenia</MudNavLink>
    @if (User?.IsAdmin() ?? false)
    {
        <MudNavLink Href="/users" Icon="@Icons.Material.Filled.Person">Użytkownicy</MudNavLink>
        <MudNavLink Href="/cost-limits" Icon="@Icons.Material.Filled.AttachMoney">Limity kosztów</MudNavLink>
    }
    <MudNavLink Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync" Disabled="@_isLoggingOut">Wyloguj się</MudNavLink>

</MudNavMenu>
