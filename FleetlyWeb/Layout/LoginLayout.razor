@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inherits LayoutComponentBase

<MudThemeProvider Theme="@FleetlyWeb.Theme.FleetlyTheme.Default" @bind-IsDarkMode="_isDarkMode" />

<MudLayout>

    <MudAppBar Elevation="4" Color="Color.Surface" Dense="true">
        <MudText Typo="Typo.h5">Fleetly</MudText>
    </MudAppBar>

    <MudMainContent Class="login-content">
        <MudPaper Elevation="5" Class="pa-6 rounded-lg login-card">
            @Body
        </MudPaper>
    </MudMainContent>

</MudLayout>

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@code {
    private bool _isDarkMode = false;
    private const string ThemeKey = "isDarkMode";

    protected override async Task OnInitializedAsync()
    {
        if (await LocalStorage.ContainKeyAsync(ThemeKey))
        {
            _isDarkMode = await LocalStorage.GetItemAsync<bool>(ThemeKey);
        }
    }
}
