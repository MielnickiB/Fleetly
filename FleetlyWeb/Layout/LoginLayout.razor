@inherits LayoutComponentBase

<MudThemeProvider Theme="@FleetlyWeb.Theme.FleetlyTheme.Default" />

<MudLayout>

    <MudAppBar Elevation="4" Color="Color.Surface" Dense="true">
        <MudText Typo="Typo.h5">Fleetly</MudText>
    </MudAppBar>

    <MudMainContent Class="login-content">
        <MudPaper Elevation="5" Class="pa-6 rounded-lg login-card">
            @Body
        </MudPaper>
    </MudMainContent>

</MudLayout>

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />
