@inherits LayoutComponentBase

<MudThemeProvider Theme="@FleetlyWeb.Theme.FleetlyTheme.Default" />

<MudLayout Style="min-height:100vh">

    <MudAppBar Elevation="5" Color="Color.Surface" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="@ToggleOpen" Color="Color.Inherit" />
        <MudText Typo="Typo.h5" Class="ml-2">Fleetly</MudText>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />
        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
    </MudAppBar>

    <MudDrawer @bind-Open="_open"
               Variant="DrawerVariant.Mini"
               Anchor="Anchor.Start"
               ClipMode="DrawerClipMode.Always"
               Elevation="4"
               Color="Color.Surface"
               Breakpoint="Breakpoint.Sm"
               aria-hidden="@(!_open)">
        <NavMenu />
    </MudDrawer>


    <MudMainContent>
        <MudContainer Class="mt-4" MaxWidth="MaxWidth.ExtraLarge">
            @Body
        </MudContainer>
    </MudMainContent>

</MudLayout>

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

@code {
    private bool _open = false;
    private void ToggleOpen() => _open = !_open;
}
