@using FleetlyWeb.Helpers

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Nie odnaleziono</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Przepraszamy, pod tym adresem nie ma żadnej treści. Spróbuj wrócić do strony głównej.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
