    private async Task OnDeleteClicked(LocationResponseDto location)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.Title, "Dezaktywacja lokalizacji" },
        { x => x.Content, $"Czy na pewno chcesz dezaktywować lokalizację {location.City} {location.Street} {location.ApartmentNumber}?" },
        { x => x.ConfirmText, "Dezaktywuj" },
        { x => x.Color, Color.Error },
        { x => x.Icon, Icons.Material.Filled.DeleteForever },
        { x => x.IconColor, Color.Error }
    };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            BackdropClick = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await DeactivateLocation(location.Id);
        }
    }

    private async Task DeactivateLocation(int id)
    {
        var response = await LocationService.DeactivateLocationAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Lokalizacja została dezaktywowana", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd dezaktywacji", Severity.Error);
        }
    }
}