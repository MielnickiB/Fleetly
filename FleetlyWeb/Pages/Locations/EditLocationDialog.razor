@inject ILocationService LocationService
@inherits FleetlyWeb.Base.DialogBase<LocationUpdateDto>

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">
            Edytuj lokalizację @Location.City, @Location.Street @Location.BuildingNumber
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <LocationForm Model="Model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="@IsBusy">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" ButtonType="ButtonType.Submit" OnClick="SubmitForm" Disabled="@IsBusy">
            @(IsBusy ? "Zapisywanie..." : "Zapisz zmiany")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public LocationResponseDto Location { get; set; } = default!;
    [Parameter] public EventCallback OnLocationUpdated { get; set; }

    protected override Task OnInitializedAsync()
    {
        Model = new LocationUpdateDto
        {
            City = Location.City,
            Street = Location.Street,
            BuildingNumber = Location.BuildingNumber,
            ApartmentNumber = Location.ApartmentNumber,
            PostalCode = Location.PostalCode,
            Description = Location.Description,
            IsPublic = Location.IsPublic
        };
        return Task.CompletedTask;
    }

    protected override async Task Submit()
    {
        var res = await LocationService.UpdateLocationAsync(Location.Id, Model);
        if (res.Success)
        {
            Snackbar.Add("Zmiany zostały zapisane.", Severity.Success);
            await OnLocationUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add(res.Error ?? "Błąd aktualizacji danych, spróbuj ponownie", Severity.Error);
        }
    }
}