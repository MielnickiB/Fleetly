@using Fleetly.Shared.Enums
@using Fleetly.Shared.Dto.LocationDtos
@using FleetlyWeb.Services.Locations
@inject ISnackbar Snackbar
@inject ILocationService LocationService

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">
            Edytuj lokalizację @Location.City, @Location.Street @Location.BuildingNumber
        </MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_updateModel" @ref="_editForm">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_updateModel.City" Label="Miasto" For="@(() => _updateModel.City)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_updateModel.Street" Label="Ulica" For="@(() => _updateModel.Street)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField T="string" @bind-Value="_updateModel.BuildingNumber" Label="Numer budynku" For="@(() => _updateModel.BuildingNumber)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_updateModel.ApartmentNumber" Label="Numer mieszkania" For="@(() => _updateModel.ApartmentNumber)" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_updateModel.PostalCode" Label="Kod pocztowy" For="@(() => _updateModel.PostalCode)" Required Variant="Variant.Outlined" Placeholder="XX-XXX" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_updateModel.Description" Label="Szczegóły" For="@(() => _updateModel.Description)" Variant="Variant.Outlined" AutoGrow MaxLines="4" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_updateModel.IsPublic" Label="Czy publiczna?" For="@(() => _updateModel.IsPublic)" Size="Size.Medium"></MudCheckBox>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="@_isBusy">Anuluj</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   ButtonType="ButtonType.Submit"
                   Disabled="@_isBusy"
                   OnClick="SubmitForm">
            @(_isBusy ? "Zapisywanie..." : "Zapisz zmiany")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public LocationResponseDto Location { get; set; } = default!;
    [Parameter] public EventCallback OnLocationUpdated { get; set; }

    private LocationUpdateDto _updateModel = new();
    private bool _isBusy = false;

    private EditForm _editForm = default!;
    private EditContext _editContext = default!;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _editForm != null && _editContext == null)
        {
            _editContext = _editForm.EditContext!;
        }
    }

    protected override Task OnInitializedAsync()
    {
        _updateModel = new LocationUpdateDto
        {
            City = Location.City,
            Street = Location.Street,
            BuildingNumber = Location.BuildingNumber,
            ApartmentNumber = Location.ApartmentNumber,
            PostalCode = Location.PostalCode,
            Description = Location.Description,
            IsPublic = Location.IsPublic
        };
        return Task.CompletedTask;
    }

    private void Cancel() => MudDialog.Cancel();

    async Task SubmitForm()
    {
        if (_editContext is null)
            return;

        var isValid = _editContext.Validate();
        if (!isValid)
        {
            Snackbar.Add("Popraw błędy w formularzu", Severity.Warning);
            return;
        }

        await Submit();
    }

    private async Task Submit()
    {
        _isBusy = true;
        try
        {
            var res = await LocationService.UpdateLocationAsync(Location.Id, _updateModel);
            if (res.Success)
            {
                Snackbar.Add("Zmiany zostały zapisane.", Severity.Success);
                await OnLocationUpdated.InvokeAsync();
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(res.Error ?? "Błąd aktualizacji", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił problem z zapisywaniem danych, spróbuj ponownie", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }
}