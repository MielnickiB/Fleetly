@using Fleetly.Shared.Dto
@using Fleetly.Shared.Dto.LocationDtos
@using FleetlyWeb.Services.Locations
@using System.ComponentModel.DataAnnotations
@inject ISnackbar Snackbar
@inject ILocationService LocationService

<MudDialog>
    <TitleContent>
        <MudText style="font-weight:bold" Typo="Typo.h6">Dodaj nową lokalizację</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="_locationModel" OnValidSubmit="Submit" @ref="_editForm">
            <DataAnnotationsValidator />
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_locationModel.City" Label="Miasto" For="@(() => _locationModel.City)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_locationModel.Street" Label="Ulica" For="@(() => _locationModel.Street)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_locationModel.BuildingNumber" Label="Numer budynku" For="@(() => _locationModel.BuildingNumber)" Required Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="6">
                    <MudTextField @bind-Value="_locationModel.ApartmentNumber" Label="Numer mieszkania" For="@(() => _locationModel.ApartmentNumber)" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_locationModel.PostalCode" Label="Kod pocztowy" For="@(() => _locationModel.PostalCode)" Required Variant="Variant.Outlined" Placeholder="XX-XXX" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_locationModel.Description" Label="Szczegóły" For="@(() => _locationModel.Description)" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_locationModel.IsPublic" Label="Czy publiczna?" For="@(() => _locationModel.IsPublic)" Required Size="Size.Medium"></MudCheckBox>
                </MudItem>
            </MudGrid>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="@_isBusy">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="@_isBusy">
            @(_isBusy ? "Dodawanie..." : "Dodaj lokalizację")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public EventCallback OnLocationAdded { get; set; }

    private readonly LocationCreateDto _locationModel = new LocationCreateDto();
    private bool _isBusy = false;
    private EditForm _editForm = default!;
    private EditContext _editContext = default!;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && _editForm != null && _editContext == null)
        {
            _editContext = _editForm.EditContext!;
        }
    }

    void Cancel()
    {
        MudDialog.Cancel();
    }

    async Task SubmitForm()
    {
        if (_editContext is null)
            return;

        var isValid = _editContext.Validate();
        if (!isValid)
        {
            Snackbar.Add("Popraw błędy w formularzu", Severity.Warning);
            return;
        }

        await Submit();
    }

    async Task Submit()
    {
        _isBusy = true;
        try
        {
            var res = await LocationService.CreateLocationAsync(_locationModel);
            if (res.Success)
            {
                Snackbar.Add("Lokalizacja została pomyślnie dodana.", Severity.Success);

                await OnLocationAdded.InvokeAsync();

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(res.Error ?? "Błąd dodawania lokalizacji, spróbuj ponownie.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Wystąpił błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }
}