@using FleetlyWeb.Components
@using Fleetly.Shared.Dto.LocationDtos
@using FleetlyWeb.Services.Locations
@inject ILocationService LocationService
@inherits FleetlyWeb.Base.DialogBase<LocationCreateDto>

<MudDialog>
    <TitleContent>
        <MudText style="font-weight:bold" Typo="Typo.h6">Dodaj nową lokalizację</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <LocationForm Model="Model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="@IsBusy">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="@IsBusy">
            @(IsBusy ? "Dodawanie..." : "Dodaj lokalizację")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public EventCallback OnLocationAdded { get; set; }

    protected override async Task Submit()
    {
        IsBusy = true;
        try
        {
            var res = await LocationService.CreateLocationAsync(Model);
            if (res.Success)
            {
                Snackbar.Add("Lokalizacja została pomyślnie dodana.", Severity.Success);

                await OnLocationAdded.InvokeAsync();

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(res.Error ?? "Błąd dodawania lokalizacji, spróbuj ponownie.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił problem z zapisywaniem danych, spróbuj ponownie", Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }
}