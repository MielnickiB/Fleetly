@using FleetlyWeb.Components
@using Fleetly.Shared.Dto.CostLimitDtos
@using FleetlyWeb.Services.CostLimits
@inject ICostLimitService CostLimitService
@inherits FleetlyWeb.Base.DialogBase<CostLimitCreateDto>

<MudDialog>
    <TitleContent>
        <MudText style="font-weight:bold" Typo="Typo.h6">Dodaj nowy próg kosztowy</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <CostLimitForm Model="Model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default" Variant="Variant.Filled" Disabled="@IsBusy">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="@IsBusy">
            @(IsBusy ? "Dodawanie..." : "Dodaj")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback OnCostLimitAdded { get; set; }

    protected override async Task Submit()
    {
        IsBusy = true;
        try
        {
            var res = await CostLimitService.CreateAsync(Model);
            if (res.Success)
            {
                Snackbar.Add("Limit kosztów został dodany.", Severity.Success);

                if (OnCostLimitAdded.HasDelegate)
                {
                    await OnCostLimitAdded.InvokeAsync();
                }

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                // Tutaj wyświetli się np. błąd o dziurze w danych z backendu
                Snackbar.Add(res.Error ?? "Błąd dodawania limitu.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Wystąpił błąd: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsBusy = false;
        }
    }
}