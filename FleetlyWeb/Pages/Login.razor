@page "/"
@layout LoginLayout
@using System.ComponentModel.DataAnnotations
@using Fleetly.Shared.Dto.AuthDtos
@using FleetlyWeb.Services.Authorization
@inject IAuthService Auth
@inject NavigationManager Nav

<MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" Style="font-weight:bold">Logowanie</MudText>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <MudTextField T="string" For="@(() => _model.Email)" @bind-Value="_model.Email" Label="Email" Required="true" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string"
                  InputType="@PasswordInput"
                  For="@(() => _model.Password)"
                  @bind-Value="_model.Password"
                  Label="Hasło"
                  Required="true"
                  Class="mb-3"
                  Adornment="Adornment.End"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  AdornmentIcon="@PasswordInputIcon"
                  OnAdornmentClick="ShowPassword" 
                  AdornmentAriaLabel="Show Password" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
    }
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.button">Zaloguj się</MudText>
        }
    </MudButton>
    <MudText Class="mt-4" Align="Align.Center">
        Nie masz konta? <MudLink Href="/register">Zarejestruj się</MudLink>
    </MudText>
</EditForm>

@code {
    private UserLoginDto _model = new UserLoginDto();
    private string? errorMessage;
    private bool _isLoading;
    private bool _isShowingPassword;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    bool success;

    async Task SubmitAsync(EditContext editContext)
    {
        errorMessage = null;
        try
        {
            _isLoading = true;
            var error = await Auth.Login(_model);

            if (string.IsNullOrEmpty(error))
            {
                success = true;
            }
            else
            {
                errorMessage = error;
            }
        }
        catch
        {
            errorMessage = "Wystąpił błąd, spróbuj ponownie.";
        }
        finally
        {
            _isLoading = false;
            if (success)
            {
                Nav.NavigateTo("/home", replace: true);
            }
            StateHasChanged();
        }
    }

    void ShowPassword()
    {
        if (_isShowingPassword)
        {
            _isShowingPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            _isShowingPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}