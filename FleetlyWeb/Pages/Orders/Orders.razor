@page "/orders"
@attribute [Authorize(Roles = "Admin, Client")]
@inject IOrderService OrderService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inherits PageBase<OrderResponseDto>

<PageTitle>Lista Zleceń</PageTitle>

<PageHeader Title="Lista Zleceń" @bind-SearchString="SearchString" InactiveValue="ShowInactive" InactiveValueChanged="OnShowInactiveChanged" SearchPlaceholder="Szukaj (Nr Zlecenia / Klient...)" OnClick="OpenAddDialogAsync" IsLoading="@IsLoading"/>
<MudItem xs="12" Class="pb-4" Style="overflow-x:auto;width:100%">
    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
        @if (!Items.Any())
        {
            @if (string.IsNullOrWhiteSpace(SearchString))
            {
                <NoItems ItemName="Zlecenia"
                         Icon="@Icons.Material.Filled.ListAlt" />
            }
            else
            {
                <NoSearchResult @bind-SearchString="SearchString" />
            }
        }
        else
        {
            <MudDataGrid T="OrderResponseDto"
                         QuickFilter="@_quickFilter"
                         Items="Items"
                         Striped="true"
                         Bordered="true"
                         Hover="true"
                         Filterable="true"
                         FixedHeader="true"
                         SortMode="SortMode.Single"
                         ColumnResizeMode="ResizeMode.Column"
                         Loading="@IsLoading"
                         FilterMode="@DataGridFilterMode.ColumnFilterMenu"
                         FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                         Class="pa-4 rounded-xl"
                         Style="margin:4px"
                         Breakpoint="Breakpoint.Sm"
                         Elevation="5"
                         RowStyleFunc="@_rowStyleFunc"
                         RowClick="OnRowClick">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="Nr Zlecenia" StickyLeft />
                    <PropertyColumn Property="x => x.Status" Title="Status zlecenia">
                        <CellTemplate>
                            <MudChip T="string"
                                     Style="@($"background-color: {context.Item.Status.ToHexColor()}; color: white; font-weight: bold;")"
                                     Text="@context.Item.Status.ToPolishName()"
                                     Size="Size.Small"
                                     Variant="Variant.Filled" />
                        </CellTemplate>
                    </PropertyColumn>
                    @if (_isAdmin)
                    {
                        <PropertyColumn Property="x => x.Client.Email" Title="Klient" />
                        <PropertyColumn Property="x => x.Client.Details.Company" Title="Firma" />
                    }
                    <PropertyColumn Property="x => x.StartLocation.City" Title="Miasto pobrania" />
                    <PropertyColumn Property="x => x.StartTime" Title="Data i godzina pobrania" Format="dd.MM.yyyy HH:mm" />
                    <PropertyColumn Property="x => x.EndLocation.City" Title="Miasto zdania" />
                    <PropertyColumn Property="x => x.Deadline" Title="Data i godzina zdania" Format="dd.MM.yyyy HH:mm" />
                    <PropertyColumn Property="x => x.MaxProjectedValue" Title="Max. Wartość zlecenia" Format="N2" CellStyle="cursor:help">
                        <CellTemplate>
                            <MudTooltip Text="@($"Maksymalne wynagrodzenie z prowizją: {(context.Item.MaxSalary * 0.3m + context.Item.MaxSalary):N2} + Limit: {context.Item.MaxNonFuelCosts:N2}. Koszty paliwa są zawsze indywidualne.")">
                                @context.Item.MaxProjectedValue.ToString("N2") zł
                            </MudTooltip>
                        </CellTemplate>
                    </PropertyColumn>
                    <TemplateColumn Title="Akcje" StickyRight>
                        <CellTemplate>
                            <MudGrid Spacing="2" Justify="Justify.FlexEnd">
                                <MudItem xs="6">
                                    <MudTooltip Placement="Placement.Bottom" Text="Anuluj zlecenie">
                                        <MudIconButton Disabled="!context.Item.IsActive || context.Item.Status > OrderStatus.OrderFinishedByWorker" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDeleteClicked(context.Item))" />
                                    </MudTooltip>
                                </MudItem>
                                @if (context.Item.IsActive && context.Item.Status < OrderStatus.OrderStarted)
                                {
                                    <MudItem xs="6">
                                        <MudTooltip Placement="Placement.Bottom" Text="Edytuj zlecenie">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                                        </MudTooltip>
                                    </MudItem>
                                }
                                @if (_isAdmin && context.Item.Status == OrderStatus.PendingApproval)
                                {
                                    <MudItem xs="6">
                                        <MudTooltip Placement="Placement.Bottom" Text="Zatwierdź do realizacji">
                                            <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" OnClick="@(() => OnAcceptClicked(context.Item))" />
                                        </MudTooltip>
                                    </MudItem>
                                }
                                @if (_isAdmin && context.Item.Status == OrderStatus.WaitingForCostApproval)
                                {
                                    <MudItem xs="6">
                                        <MudTooltip Placement="Placement.Bottom" Text="Zatwierdź koszty i zakończ">
                                            <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Money" Color="Color.Success" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/orders/{context.Item.Id}"))" />
                                        </MudTooltip>
                                    </MudItem>
                                }
                            </MudGrid>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="OrderResponseDto"
                                      RowsPerPageString="Wierszy na stronę"
                                      InfoFormat="{first_item}-{last_item} z {all_items}"
                                      PageSizeOptions="new int[] { 10, 15, 25, 50 }" />
                </PagerContent>
            </MudDataGrid>
        }
    }
</MudItem>

@if (TotalItems > 0)
{
    <MobileActionButton OnClick="OpenAddDialogAsync" />
}

@code {
    private ClaimsPrincipal? User;
    private bool _isAdmin => User?.IsInRole("Admin") ?? false;
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        User = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
    }
    protected override async Task LoadDataAsync()
    {
        IsLoading = true;

        var response = await OrderService.GetAllOrdersAsync(ShowInactive);

        if (response.Success)
        {
            Items = response.Data?.Items ?? new List<OrderResponseDto>();
            TotalItems = response.Data?.TotalCount ?? 0;
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd pobierania danych", Severity.Error);
        }
        IsLoading = false;
    }

    private Func<OrderResponseDto, bool> _quickFilter => x =>
    {
        if (!ShowInactive && !x.IsActive)
            return false;
        if (string.IsNullOrWhiteSpace(SearchString))
            return true;
        if (x.Id.ToString().Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Client.Email.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Client.Details.Company != null && x.Client.Details.Company.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.StartLocation.City.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.EndLocation.City.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    };

    private async Task OpenAddDialogAsync()
    {
        var parameters = new DialogParameters<AddOrderDialog>
            {
                { x => x.OnOrderAdded, new EventCallback(this, LoadDataAsync) }
            };

        var dialogRef = await DialogService.ShowAsync<AddOrderDialog>("Dodaj zlecenie", parameters, DialogHelper.GetStandardFormOptions());
        await dialogRef.Result;
    }

    private async Task OpenEditDialogAsync(OrderResponseDto order)
    {
        var parameters = new DialogParameters<EditOrderDialog>
            {
                { x => x.Order, order },
                { x => x.OnOrderUpdated, new EventCallback(this, LoadDataAsync) }
            };
        var dialogRef = await DialogService.ShowAsync<EditOrderDialog>("Edytuj zlecenie", parameters, DialogHelper.GetStandardFormOptions());
        await dialogRef.Result;
    }

    private async Task OnDeleteClicked(OrderResponseDto order)
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Anulzacja zlecenia" },
            { x => x.Content, $"Czy na pewno chcesz anulować to zlecenie?" },
            { x => x.ConfirmText, "Anuluj" },
            { x => x.Color, Color.Error },
            { x => x.Icon, Icons.Material.Filled.DeleteForever },
            { x => x.IconColor, Color.Error }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, DialogHelper.GetConfirmationOptions());
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CancellOrder(order.Id);
        }
    }

    private async Task CancellOrder(int id)
    {
        var response = await OrderService.CancelOrderAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Zlecenie zostało anulowane", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd anulowania", Severity.Error);
        }
    }

    private async Task OnAcceptClicked(OrderResponseDto order)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.Title, "Akceptacja zlecenia" },
        { x => x.Content, $"Czy na pewno chcesz zaakceptować to zlecenie?" },
        { x => x.ConfirmText, "Akceptuj" },
        { x => x.Color, Color.Success },
        { x => x.Icon, Icons.Material.Filled.Check },
        { x => x.IconColor, Color.Success }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, DialogHelper.GetConfirmationOptions());
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await ApproveOrder(order.Id);
        }
    }

    private async Task ApproveOrder(int id)
    {
        var response = await OrderService.ApproveOrderAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Zlecenie zostało zaakceptowane", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd akceptacji", Severity.Error);
        }
    }

    private void OnRowClick(DataGridRowClickEventArgs<OrderResponseDto> args)
    {
        Nav.NavigateTo($"/orders/{args.Item.Id}");
    }

    private Func<OrderResponseDto, int, string> _rowStyleFunc => (x, i) =>
    {
        string style = "cursor: pointer;";

        if (x.Status == OrderStatus.Cancelled)
            style += "background-color: #F8D7DA;";

        if (x.Status == OrderStatus.ApprovedByAdmin)
            style += "background-color: #C8E6C9;";

        return style;
    };
}
