@typeparam T where T : OrderCreateDto
@using Fleetly.Shared.Dto.VehicleDtos
@using Fleetly.Shared.Dto.LocationDtos
@using Fleetly.Shared.Dto.OrderDtos
@using FleetlyWeb.Services
@using FleetlyWeb.Services.Locations
@using FleetlyWeb.Services.Orders
@using Fleetly.Shared.Enums
@using FleetlyWeb.Extensions
@inject IVehicleService VehicleService
@inject ILocationService LocationService
@inject IOrderService OrderService
@inject ISnackbar Snackbar

<MudGrid>
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="LocationResponseDto"
                         Label="Lokalizacja początkowa"
                         Value="_selectedStartLocation"
                         ValueChanged="OnStartLocationChanged"
                         SearchFunc="@SearchLocations"
                         ToStringFunc="@(l => l == null ? null : $"{l.City}, {l.Street} {l.BuildingNumber}" + (string.IsNullOrEmpty(l.ApartmentNumber) ? "" : $"/{l.ApartmentNumber}") + $" ({l.PostalCode})")"
                         Variant="Variant.Outlined"
                         Required
                         Clearable
                         AdornmentIcon="@Icons.Material.Filled.Circle"
                         AdornmentColor="Color.Success" />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="LocationResponseDto"
                         Label="Lokalizacja końcowa"
                         Value="_selectedEndLocation"
                         ValueChanged="OnEndLocationChanged"
                         SearchFunc="@SearchLocations"
                         ToStringFunc="@(l => l == null ? null : $"{l.City}, {l.Street} {l.BuildingNumber}" + (string.IsNullOrEmpty(l.ApartmentNumber) ? "" : $"/{l.ApartmentNumber}") + $" ({l.PostalCode})")"
                         Variant="Variant.Outlined"
                         Required
                         Clearable
                         AdornmentIcon="@Icons.Material.Filled.LocationOn"
                         AdornmentColor="Color.Error" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudNumericField @bind-Value="Model.RangeOfKm" Label="Dystans (km)" For="@(() => Model.RangeOfKm)" Variant="Variant.Outlined" HelperText="Wypełniany automatycznie" Min="1" ReadOnly Required/>
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudAutocomplete T="VehicleResponseDto"
                         Label="Wybierz pojazd"
                         Value="_selectedVehicle"
                         ValueChanged="OnVehicleChanged"
                         SearchFunc="@SearchVehicles"
                         ToStringFunc="@(v => v == null ? null : $"{v.BrandModel?.CarBrandName} {v.BrandModel?.ModelName} ({v.RegistrationNumber})")"
                         Variant="Variant.Outlined"
                         Required
                         Clearable
                         RequiredError="Pojazd jest wymagany"
                         ResetValueOnEmptyText="true" />
        <MudTextField @bind-Value="Model.VehicleId" For="@(() => Model.VehicleId)" Style="display:none" />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.StartTime" Label="Data rozpoczęcia" For="@(() => Model.StartTime)" InputType="InputType.DateTimeLocal" Variant="Variant.Outlined" Converter="@_dateConverter" Required />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.Deadline" Label="Termin końcowy (Deadline)" For="@(() => Model.Deadline)" InputType="InputType.DateTimeLocal" Variant="Variant.Outlined" Converter="@_dateConverter" Required />
    </MudItem>

    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.EndContactName" Label="Osoba kontaktowa (Zdanie)" For="@(() => Model.EndContactName)" Variant="Variant.Outlined" Required />
    </MudItem>
    <MudItem xs="12" sm="6">
        <MudTextField @bind-Value="Model.EndContactPhone" Label="Telefon (Zdanie)" For="@(() => Model.EndContactPhone)" Variant="Variant.Outlined" Required />
    </MudItem>

    <MudItem xs="12">
        <MudTextField @bind-Value="Model.Details" Label="Szczegóły zlecenia / Uwagi" For="@(() => Model.Details)" Variant="Variant.Outlined" AutoGrow MaxLines="3" />
    </MudItem>
    <MudItem xs="12">
        @ChildContent
    </MudItem>
</MudGrid>

@code {
    [Parameter] public T Model { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private List<VehicleResponseDto> _vehicles = new();
    private List<LocationResponseDto> _locations = new();

    private VehicleResponseDto? _selectedVehicle;
    private LocationResponseDto? _selectedStartLocation;
    private LocationResponseDto? _selectedEndLocation;

    protected override async Task OnInitializedAsync()
    {
        var vTask = VehicleService.GetAllVehiclesAsync();
        var lTask = LocationService.GetAllLocationsAsync();

        await Task.WhenAll(vTask, lTask);

        var vRes = vTask.Result;
        var lRes = lTask.Result;

        if (vRes.Success) _vehicles = vRes.Data?.Items.ToList() ?? new();
        if (lRes.Success) _locations = lRes.Data?.Items.ToList() ?? new();

        if (Model.VehicleId != 0)
            _selectedVehicle = _vehicles.FirstOrDefault(x => x.Id == Model.VehicleId);

        if (Model.StartLocationId != 0)
            _selectedStartLocation = _locations.FirstOrDefault(x => x.Id == Model.StartLocationId);

        if (Model.EndLocationId != 0)
            _selectedEndLocation = _locations.FirstOrDefault(x => x.Id == Model.EndLocationId);

        if (Model.StartTime == DateTime.MinValue) Model.StartTime = DateTime.Now.AddHours(1);
        if (Model.Deadline == DateTime.MinValue) Model.Deadline = DateTime.Now.AddDays(1);
    }

    private Task<IEnumerable<VehicleResponseDto>> SearchVehicles(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<VehicleResponseDto>>(_vehicles);

        return Task.FromResult(_vehicles.Where(x =>
            x.RegistrationNumber.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            (x.BrandModel?.CarBrandName?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false) ||
            (x.BrandModel?.ModelName?.Contains(value, StringComparison.InvariantCultureIgnoreCase) ?? false)
        ));
    }

    private Task<IEnumerable<LocationResponseDto>> SearchLocations(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<LocationResponseDto>>(_locations);

        return Task.FromResult(_locations.Where(x =>
            x.City.Contains(value, StringComparison.InvariantCultureIgnoreCase) ||
            x.Street.Contains(value, StringComparison.InvariantCultureIgnoreCase)
        ));
    }

    private readonly Converter<DateTime> _dateConverter = new Converter<DateTime>
    {
        SetFunc = value => value.ToString("yyyy-MM-ddTHH:mm"),

        GetFunc = text => DateTime.TryParse(text, out var date) ? date : DateTime.MinValue
    };

    private void OnVehicleChanged(VehicleResponseDto vehicle)
    {
        _selectedVehicle = vehicle;
        Model.VehicleId = vehicle?.Id ?? 0;
    }

    private async void OnStartLocationChanged(LocationResponseDto location)
    {
        _selectedStartLocation = location;
        Model.StartLocationId = location?.Id ?? 0;
        await CalculateDistanceIfReady();
    }

    private async void OnEndLocationChanged(LocationResponseDto location)
    {
        _selectedEndLocation = location;
        Model.EndLocationId = location?.Id ?? 0;
        await CalculateDistanceIfReady();
    }

    private async Task CalculateDistanceIfReady()
    {
        if (_selectedStartLocation != null && _selectedEndLocation != null)
        {
            var startAddr = BuildAddressString(_selectedStartLocation);
            var endAddr = BuildAddressString(_selectedEndLocation);

            Snackbar.Add("Obliczam dystans...", Severity.Info);

            var response = await OrderService.CalculateDistanceAsync(startAddr, endAddr);

            if (response.Success && response.Data > 0)
            {
                Model.RangeOfKm = response.Data;
                Snackbar.Add($"Obliczono dystans: {Model.RangeOfKm} km", Severity.Success);

                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Nie udało się automatycznie wyliczyć trasy.", Severity.Warning);
            }
        }
    }

    private string BuildAddressString(LocationResponseDto loc)
    {
        return $"{loc.Street} {loc.BuildingNumber}, {loc.PostalCode} {loc.City}";
    }
}