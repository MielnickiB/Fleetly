@using Fleetly.Shared.Dto.OrderDtos;

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Szczegóły zlecenia #@Order.Id</MudText>
    </TitleContent>

    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.ClientName" Label="Klient" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.WorkerName" Label="Pracownik" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.VehicleName" Label="Pojazd" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.VehicleRegistrationNumber" Label="Nr rejestracyjny pojazdu" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.Type" Label="Typ zlecenia" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.Status" Label="Status zlecenia" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.StartLocationCity" Label="Miasto początkowe" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.StartLocationAddress" Label="Adres" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            @if (Order.ServiceLocationId is not null)
            {
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@Order.ServiceLocationCity" Label="Miasto serwisu" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@Order.ServiceLocationAddress" Label="Adres" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
                </MudItem>
            }

            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.EndLocationCity" Label="Miasto końcowe" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.EndLocationAddress" Label="Adres" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudTextField Value="@Order.RangeOfKm" Label="Dystans do przejechania (w km)" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Value="@Order.Salary" Label="Wynagrodzenie (w zł)" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Value="@Order.AdditionalCosts" Label="Dodatkowe koszty (w zł)" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudTextField Value="@Order.FuelCosts" Label="Koszty paliwowe (w zł)" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudTextField Value="@Order.StartTime.ToString("g")" Label="Data i godzina pobrania" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            @if (Order.ServiceTime is not null)
            {
                <MudItem xs="12" sm="4">
                    <MudTextField Value="@Order.ServiceTime?.ToString("g")" Label="Data i godzina serwisu" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            }
            <MudItem xs="12" sm="4">
                <MudTextField Value="@Order.Deadline.ToString("g")" Label="Data i godzina zwrotu" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.CreatedAt.ToString("g")" Label="Data i godzina utworzenia" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Value="@Order.UpdatedAt?.ToString("g")" Label="Data i godzina aktualizacji" Variant="Variant.Outlined" ReadOnly="true" FullWidth="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled">OK</MudButton>
        <MudButton OnClick="Cancel" Color="Color.Secondary" Variant="Variant.Outlined">Anuluj</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public OrderResponseDto Order { get; set; } = default!;

    private void Submit() => MudDialog.Close(DialogResult.Ok(true));
    private void Cancel() => MudDialog.Cancel();
}