@page "/register"
@layout LoginLayout
@using Fleetly.Shared.Dto.AuthDtos
@using FleetlyWeb.Services
@using System.ComponentModel.DataAnnotations
@inject IAuthService Auth
@inject NavigationManager Nav

<MudText Typo="Typo.h4" Align="Align.Center" Class="mb-4">Rejestracja</MudText>

<EditForm Model="_model" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <MudTextField T="string" For="@(() => _model.Email)" @bind-Value="_model.Email" Label="Email" Required="true" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string"
                  InputType="@PasswordInput"
                  For="@(() => _model.Password)"
                  @bind-Value="_model.Password"
                  Label="Hasło"
                  Required="true"
                  Class="mb-3"
                  Adornment="Adornment.End"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  AdornmentIcon="@PasswordInputIcon"
                  OnAdornmentClick="ShowPassword"
                  AdornmentAriaLabel="Show Password" />
    <MudTextField T="string"
                  InputType="@PasswordInput"
                  For="@(() => _model.PasswordConfirm)"
                  @bind-Value="_model.PasswordConfirm"
                  Label="Hasło"
                  Required="true"
                  Class="mb-3"
                  Adornment="Adornment.End"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  AdornmentIcon="@PasswordInputIcon"
                  OnAdornmentClick="ShowPassword"
                  AdornmentAriaLabel="Show Password" />
    <MudTextField T="string" For="@(() => _model.Details.Name)" @bind-Value="_model.Details.Name" Label="Imię" Required="true" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" For="@(() => _model.Details.Surname)" @bind-Value="_model.Details.Surname" Label="Nazwisko" Required="true" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" For="@(() => _model.Details.PhoneNumber)" @bind-Value="_model.Details.PhoneNumber" Required="true" HelperTextOnFocus="true" HelperText="Wpisz np: 123123123" Label="Numer Telefonu" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField T="string" For="@(() => _model.Details.Company)" @bind-Value="_model.Details.Company" Label="Nazwa fimry" Class="mb-3" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <ValidationMessage For="@(() => _model.Details)" />

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
    }
    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Disabled="_isLoading">
        @if (_isLoading)
        {
            <MudProgressCircular Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
        }
        else
        {
            <MudText Typo="Typo.button">Zarejestruj się</MudText>
        }
    </MudButton>
    <MudText Class="mt-4" Align="Align.Center">
        Masz już konto? <MudLink Href="/">Zaloguj się</MudLink>
    </MudText>
</EditForm>

@code {
    private UserRegisterDto _model = new UserRegisterDto();
    private string? errorMessage;
    private bool _isLoading;
    private bool _isShowingPassword;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
    bool success;

    async Task SubmitAsync(EditContext editContext)
    {
        errorMessage = null;
        try
        {
            _isLoading = true;
            var error = await Auth.Register(_model);

            if (string.IsNullOrEmpty(error))
            {
                success = true;
            }
            else
            {
                errorMessage = error;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Wystąpił błąd: " + ex.Message;
        }
        finally
        {
            _isLoading = false;
            if (success)
            {
                Nav.NavigateTo("/", replace: true);
            }
            StateHasChanged();
        }
    }

    void ShowPassword()
    {
        @if (_isShowingPassword)
        {
            _isShowingPassword = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            _isShowingPassword = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }
}