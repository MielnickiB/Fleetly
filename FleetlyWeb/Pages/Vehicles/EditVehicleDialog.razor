@using Fleetly.Shared.Dto.VehicleDtos
@using FleetlyWeb.Components
@inherits FleetlyWeb.Base.DialogBase<VehicleUpdateDto>
@inject IVehicleService VehicleService

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">Edytuj: @Vehicle.RegistrationNumber</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <VehicleForm T="VehicleUpdateDto" Model="Model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy" Variant="Variant.Filled" Color="Color.Default">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="IsBusy">
            @(IsBusy ? "Zapisywanie..." : "Zapisz zmiany") || @(Vehicle.BrandModelId == 0)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public VehicleResponseDto Vehicle { get; set; } = default!;
    [Parameter] public EventCallback OnVehicleUpdated { get; set; }

    protected override void OnInitialized()
    {
        Model = new VehicleUpdateDto
        {
            RegistrationNumber = Vehicle.RegistrationNumber,
            VIN = Vehicle.VIN,
            FuelType = Vehicle.FuelType,
            BrandModelId = Vehicle.BrandModelId,
            Year = Vehicle.Year,
            Mileage = Vehicle.Mileage,
            Details = Vehicle.Details
        };
    }

    protected override async Task Submit()
    {
        var res = await VehicleService.UpdateVehicleAsync(Vehicle.Id, Model);
        if (res.Success)
        {
            Snackbar.Add("Zmiany zostały zapisane", Severity.Success);
            await OnVehicleUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(res.Error ?? "Błąd aktualizacji pojazdu", Severity.Error);
    }
}