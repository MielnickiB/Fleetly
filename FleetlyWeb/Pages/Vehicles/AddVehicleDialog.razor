@using Fleetly.Shared.Dto.VehicleDtos
@using FleetlyWeb.Components
@inherits FleetlyWeb.Base.DialogBase<VehicleCreateDto>
@inject IVehicleService VehicleService

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">Dodaj pojazd</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <VehicleForm T="VehicleCreateDto" Model="Model" />
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy" Variant="Variant.Filled" Color="Color.Default">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="@(IsBusy || Model.BrandModelId == 0)">
            @(IsBusy ? "Dodawanie..." : "Dodaj pojazd")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback OnVehicleAdded { get; set; }

    protected override async Task Submit()
    {
        var res = await VehicleService.CreateVehicleAsync(Model);
        if (res.Success)
        {
            Snackbar.Add("Pojazd dodany pomyślnie", Severity.Success);
            await OnVehicleAdded.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(res.Error ?? "Nie udało się dodać pojazdu", Severity.Error);
    }
}