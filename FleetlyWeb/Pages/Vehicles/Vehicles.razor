@page "/vehicles"
@attribute [Authorize(Roles = "Admin, Client")]
@using Fleetly.Shared
@using Fleetly.Shared.Dto
@using Fleetly.Shared.Dto.VehicleDtos
@using Fleetly.Shared.Enums
@using FleetlyWeb.Components
@inject IVehicleService vehicleService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inherits FleetlyPageBase<VehicleResponseDto>

<PageTitle>Lista Pojazdów</PageTitle>

<PageHeader Title="Lista Pojazdów" @bind-SearchString="SearchString" @bind-InactiveValue="ShowInactive" SearchPlaceholder="Szukaj (Nr rej / Marka / Model...)" OnClick="OpenAddDialogAsync" />
<MudItem xs="12" Style="overflow-x:auto;width:100%">
    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else if (TotalItems == 0)
    {
        <NoItems ItemName="Pojazdy"
                 Icon="@Icons.Material.Filled.DirectionsCar"
                 OnAddClicked="OpenAddDialogAsync" />
    }
    else
    {
        <MudDataGrid T="VehicleResponseDto"
                     QuickFilter="@_quickFilter"
                     Items="Items"
                     Striped="true"
                     Bordered="true"
                     SortMode="SortMode.Single"
                     ColumnResizeMode="ResizeMode.Column"
                     Loading="@IsLoading"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     Class="pa-4 rounded-xl"
                     Style="margin:4px"
                     FixedHeader="true"
                     Elevation="5"
                     RowStyleFunc="@_rowStyleFunc"
                     RowStyle="font-weight:bold;">
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Nr" Editable="false" Filterable="false" StickyLeft />
                <PropertyColumn Property="x => x.RegistrationNumber" Title="Nr rejestracyjny" />
                <PropertyColumn Property="x => x.UserFullName" Title="Właściciel" />
                <PropertyColumn Property="x => x.BrandModel.CarBrandName" Title="Marka" />
                <PropertyColumn Property="x => x.BrandModel.ModelName" Title="Model" />
                <PropertyColumn Property="x => x.FuelType" Title="Paliwo" />
                <PropertyColumn Property="x => x.Year" Title="Rok prod." />
                <PropertyColumn Property="x => x.Mileage" Title="Przebieg (km)" />
                <TemplateColumn Title="Akcje" StickyRight>
                    <CellTemplate>
                        <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                        <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDeleteClicked(context.Item))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="VehicleResponseDto"
                                  RowsPerPageString="Wierszy na stronę"
                                  InfoFormat="{first_item}-{last_item} z {all_items}"
                                  PageSizeOptions="new int[] { 10, 15, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    }
</MudItem>

@if (TotalItems > 0)
{
    <MobileActionButton OnClick="OpenAddDialogAsync" />
}

@code {
    protected override async Task OnInitializedAsync() => await LoadDataAsync();
    protected override async Task LoadDataAsync()
    {
        try
        {
            IsLoading = true;
            var apiResponse = await vehicleService.GetAllVehiclesAsync();
            if (apiResponse.Success)
            {
                Items = apiResponse.Data!.Items!;
                TotalItems = apiResponse.Data.TotalCount;
            }
            else
            {
                Snackbar.Add($"Błąd ładowania pojazdów: {apiResponse.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd ładowania pojazdów: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Func<VehicleResponseDto, bool> _quickFilter => x =>
    {
        if (!ShowInactive && !x.IsActive)
            return false;
        if (string.IsNullOrWhiteSpace(SearchString))
            return true;
        if (x.RegistrationNumber?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.BrandModel?.CarBrandName?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.BrandModel?.ModelName?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.VIN?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.UserFullName?.Contains(SearchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    };

    private Func<VehicleResponseDto, int, string> _rowStyleFunc => (x, i) =>
    {
        if (x.IsActive)
        {
            return "";
        }

        return "background-color: #f8d7da; color: #721c24;";
    };

    private async Task OpenAddDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true,
            BackgroundClass = "blurry-bg"
        };

        var parameters = new DialogParameters<AddVehicleDialog>
        {
            { x => x.OnVehicleAdded, new EventCallback(this, LoadDataAsync) }
        };

        var dialogRef = await DialogService.ShowAsync<AddVehicleDialog>("Dodaj pojazd", parameters, options);
        await dialogRef.Result;
    }

    private async Task OpenEditDialogAsync(VehicleResponseDto vehicle)
    {
        var parameters = new DialogParameters<EditVehicleDialog>
        {
            { x => x.Vehicle, vehicle },
            { x => x.OnVehicleUpdated, new EventCallback(this, LoadDataAsync)  }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            CloseButton = true,
            BackgroundClass = "blurry-bg"
        };

        var dialogRef = await DialogService.ShowAsync<EditVehicleDialog>("Edytuj pojazd", parameters, options);
        await dialogRef.Result;
    }

    private async Task OnDeleteClicked(VehicleResponseDto vehicle)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.Title, "Dezaktywacja pojazdu" },
        { x => x.Content, $"Czy na pewno chcesz dezaktywować pojazd o numerze {vehicle.RegistrationNumber}?" },
        { x => x.ConfirmText, "Dezaktywuj" },
        { x => x.Color, Color.Error },
        { x => x.Icon, Icons.Material.Filled.DeleteForever },
        { x => x.IconColor, Color.Error }
    };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            BackdropClick = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await DeactivateVehicle(vehicle.Id);
        }
    }

    private async Task DeactivateVehicle(int id)
    {
        var response = await vehicleService.DeactivateVehicleAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Pojazd został dezaktywowany", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd dezaktywacji", Severity.Error);
        }
    }
}