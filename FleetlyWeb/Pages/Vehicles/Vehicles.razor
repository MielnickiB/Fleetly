@page "/vehicles"
@attribute [Authorize(Roles = "Admin, Client")]
@using Fleetly.Shared.Dto
@using Fleetly.Shared.Dto.VehicleDtos
@using Fleetly.Shared.Enums
@inject IVehicleService vehicleService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<style>
    .fab-container {
        position: fixed;
        right: 24px;
        bottom: 24px;
        z-index: 1100;
    }
</style>

<PageTitle>Lista Pojazdów</PageTitle>

<MudGrid Justify="Justify.Center" Class="py-4">
    <MudItem xs="12">
        <MudText Typo="Typo.h5" Class="mb-4" Style="font-weight:bold">Lista pojazdów</MudText>
        <MudPaper Elevation="5" Class="d-flex flex-row align-center justify-center pa-5 rounded-xl" Style="width:100%">
            <MudTextField T="string"
                          @bind-Value="_searchString"
                          Placeholder="Szukaj (Nr rej / Marka / Model / VIN...)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          IconSize="Size.Medium"
                          DebounceInterval="300"
                          Variant="Variant.Outlined"
                          Clearable />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" Class="d-flex flex-row align-center">
        <MudSwitch @bind-Value="_showInactive" Label="Pokaż nieaktywne" />
        <MudSpacer />
        <MudButton @onclick="OpenAddDialogAsync" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Class="d-none d-sm-flex">
            Dodaj nowy pojazd
        </MudButton>
    </MudItem>
    <MudItem xs="12" Style="overflow-x:auto;width:100%">
        <MudDataGrid T="VehicleResponseDto"
                     QuickFilter="@_quickFilter"
                     Items="_vehicles"
                     Striped="true"
                     Bordered="true"
                     SortMode="SortMode.Single"
                     ColumnResizeMode="ResizeMode.Column"
                     Loading="@_isLoading"
                     Filterable="true"
                     FilterMode="@DataGridFilterMode.ColumnFilterMenu"
                     FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                     Class="pa-4 rounded-xl"
                     Style="margin:4px"
                     FixedHeader="true"
                     Elevation="5"
                     RowStyleFunc="@_rowStyleFunc"
                     RowStyle="font-weight:bold;">
            <Columns>
                <PropertyColumn Property="x => x.Id" Title="Nr" Editable="false" Filterable="false" StickyLeft />
                <PropertyColumn Property="x => x.RegistrationNumber" Title="Nr rejestracyjny" />
                <PropertyColumn Property="x => x.UserFullName" Title="Właściciel" />
                <PropertyColumn Property="x => x.BrandModel.CarBrandName" Title="Marka" />
                <PropertyColumn Property="x => x.BrandModel.ModelName" Title="Model" />
                <PropertyColumn Property="x => x.FuelType" Title="Paliwo" />
                <PropertyColumn Property="x => x.Year" Title="Rok prod." />
                <PropertyColumn Property="x => x.Mileage" Title="Przebieg (km)" />
                <TemplateColumn Title="Akcje" StickyRight>
                    <CellTemplate>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                        <MudIconButton Disabled="context.Item.IsActive ? false : true" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OpenDeleteDialogAsync(context.Item.Id))" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>

            <PagerContent>
                <MudDataGridPager T="VehicleResponseDto"
                                  RowsPerPageString="Wierszy na stronę"
                                  InfoFormat="{first_item}-{last_item} z {all_items}"
                                  PageSizeOptions="new int[] { 10, 15, 25, 50 }" />
            </PagerContent>
        </MudDataGrid>
    </MudItem>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Elevation="5" Variant="Variant.Filled" Class="mt-4" ShowCloseIcon="true" CloseIconClicked="(() => CloseMe())">
            @_errorMessage
        </MudAlert>
    }
</MudGrid>

<div class="fab-container d-flex d-sm-none">
    <MudFab OnClick="OpenAddDialogAsync"
            StartIcon="@Icons.Material.Filled.Add"
            Size="Size.Large"
            Color="Color.Primary" />
</div>

@code {
    private IEnumerable<VehicleResponseDto> _vehicles = Enumerable.Empty<VehicleResponseDto>();
    private bool _isLoading = false;
    private string _errorMessage = string.Empty;
    private string? _searchString = string.Empty;
    private bool _showInactive = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadVehicles();
    }

    private async Task LoadVehicles()
    {
        try
        {
            _isLoading = true;
            var apiResponse = await vehicleService.GetAllVehiclesAsync();
            if (apiResponse.Success)
            {
                _vehicles = apiResponse.Data!.Items!;
            }
            else
            {
                _errorMessage = $"Błąd ładowania pojazdów: {apiResponse.Error}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Wystąpił nieoczekiwany błąd: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Func<VehicleResponseDto, bool> _quickFilter => x =>
    {
        if (!_showInactive && !x.IsActive)
            return false;
        if (string.IsNullOrWhiteSpace(_searchString))
            return true;
        if (x.RegistrationNumber?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.BrandModel?.CarBrandName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.BrandModel?.ModelName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.VIN?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (x.UserFullName?.Contains(_searchString, StringComparison.OrdinalIgnoreCase) == true)
            return true;
        return false;
    };

    private Func<VehicleResponseDto, int, string> _rowStyleFunc => (x, i) =>
    {
        if (x.IsActive)
        {
            return "";
        }

        return "background-color: #f8d7da; color: #721c24;";
    };

    private void CloseMe()
    {
        _errorMessage = string.Empty;
    }

    private async Task OpenAddDialogAsync()
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackgroundClass = "blurry-bg"
        };

        var parameters = new DialogParameters<AddVehicleDialog>
        {
            { x => x.OnVehicleAdded, new EventCallback(this, LoadVehicles) }
        };

        var dialogRef = await DialogService.ShowAsync<AddVehicleDialog>("Dodaj pojazd", parameters, options);
        await dialogRef.Result;
    }

    private async Task OpenDeleteDialogAsync(int vehicleId)
    {
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackgroundClass = "blurry-bg"
        };

        var parameters = new DialogParameters<DeleteVehicleDialog>
        {
            { x => x.VehicleId, vehicleId },
            { x => x.OnVehicleDeleted, new EventCallback(this, LoadVehicles) }
        };

        var dialogRef = await DialogService.ShowAsync<DeleteVehicleDialog>("Usuń pojazd", parameters, options);
        await dialogRef.Result;
    }

    private async Task OpenEditDialogAsync(VehicleResponseDto vehicle)
    {
        var parameters = new DialogParameters<EditVehicleDialog> { 
            { x => x.Vehicle, vehicle },
            { x => x.OnVehicleUpdated, new EventCallback(this, LoadVehicles)  }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

        var dialogRef = await DialogService.ShowAsync<EditVehicleDialog>("Edytuj pojazd", parameters, options);
        await dialogRef.Result;
    }
}