@using Fleetly.Shared.Dto.UserDtos
@using Fleetly.Shared.Dto.UserDetailsDtos
@using FleetlyWeb.Services.Users
@using FleetlyWeb.Base
@using FleetlyWeb.Components
@inherits DialogBase<UserUpdateDto>
@inject IUserService UserService

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">Edytuj: @User.Details.Name @User.Details.Surname</MudText>
    </TitleContent>
    <DialogContent>
        @if (Model.Details != null)
        {
            <EditForm Model="Model" @ref="EditForm">
                <DataAnnotationsValidator />
                <UserForm T="UserUpdateDto" Model="Model">
                    <MudTextField @bind-Value="Model.Password" Label="Zmień hasło" For="@(() => Model.Password)" 
                                  InputType="InputType.Password" Variant="Variant.Outlined" HelperText="Zostaw puste, aby nie zmieniać" />
                </UserForm>
            </EditForm>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy" Color="Color.Default" Variant="Variant.Filled">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="IsBusy">
            @(IsBusy ? "Zapisywanie..." : "Zapisz")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public UserResponseDto User { get; set; } = default!;
    [Parameter] public EventCallback OnUserUpdated { get; set; }

    protected override void OnInitialized()
    {
        Model = new UserUpdateDto
        {
            Email = User.Email,
            RoleId = User.RoleId,
            Details = new UserDetailsDto
            {
                Name = User.Details.Name,
                Surname = User.Details.Surname,
                PhoneNumber = User.Details.PhoneNumber,
                Company = User.Details.Company
            }
        };
    }

    protected override async Task Submit()
    {
        var res = await UserService.UpdateUserAsync(User.Id, Model);
        if (res.Success)
        {
            Snackbar.Add("Dane użytkownika zostały zaktualizowane", Severity.Success);
            await OnUserUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(res.Error ?? "Błąd", Severity.Error);
    }
}