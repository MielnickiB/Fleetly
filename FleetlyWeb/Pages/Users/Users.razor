    private async Task OnDeleteClicked(UserResponseDto user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.Title, "Dezaktywacja użytkownika" },
        { x => x.Content, $"Czy na pewno chcesz dezaktywować użytkownika o id {user.Id}?" },
        { x => x.ConfirmText, "Dezaktywuj" },
        { x => x.Color, Color.Error },
        { x => x.Icon, Icons.Material.Filled.DeleteForever },
        { x => x.IconColor, Color.Error }
    };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.ExtraSmall,
            BackdropClick = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await DeactivateUser(user.Id);
        }
    }

    private async Task DeactivateUser(int id)
    {
        var response = await UserService.DeactivateUserAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Użytkownik został dezaktywowany", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd dezaktywacji", Severity.Error);
        }
    }
