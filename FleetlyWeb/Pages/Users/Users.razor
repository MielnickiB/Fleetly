@page "/users"
@attribute [Authorize(Roles = "Admin")]
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inherits PageBase<UserResponseDto>

<PageTitle>Lista Użytkowników</PageTitle>

<PageHeader Title="Lista Użytkowników" @bind-SearchString="SearchString" InactiveValue="ShowInactive" InactiveValueChanged="OnShowInactiveChanged" SearchPlaceholder="Szukaj (Imię / Nazwisko / Email...)" OnClick="OpenAddDialogAsync" IsLoading="@IsLoading" />
<MudItem xs="12" Class="pb-4" Style="overflow-x:auto;width:100%">
    @if (IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
    }
    else
    {
        @if (!Items.Any())
        {
            @if (string.IsNullOrWhiteSpace(SearchString))
            {
                <NoItems ItemName="Użytkownicy"
                         Icon="@Icons.Material.Filled.Person"
                         OnAddClicked="OpenAddDialogAsync" />
            }
            else
            {
                <NoSearchResult @bind-SearchString="SearchString" />
            }
        }
        else
        {
            <MudDataGrid T="UserResponseDto"
                         QuickFilter="@_quickFilter"
                         Items="Items"
                         Hover="true"
                         Striped="true"
                         Bordered="true"
                         Filterable="true"
                         FixedHeader="true"
                         SortMode="SortMode.Single"
                         ColumnResizeMode="ResizeMode.Column"
                         Loading="@IsLoading"
                         FilterMode="@DataGridFilterMode.ColumnFilterMenu"
                         FilterCaseSensitivity="DataGridFilterCaseSensitivity.CaseInsensitive"
                         Class="pa-4 rounded-xl"
                         Style="margin:4px"
                         Elevation="5"
                         RowStyleFunc="@_rowStyleFunc"
                         RowStyle="font-weight:bold;">
                <Columns>
                    <PropertyColumn Property="x => x.Id" Title="Nr" Editable="false" Filterable="false" StickyLeft />
                    <PropertyColumn Property="x => x.Details.Name" Title="Imię" />
                    <PropertyColumn Property="x => x.Details.Surname" Title="Nazwisko" />
                    <PropertyColumn Property="x => x.Email" Title="Email" />
                    <PropertyColumn Property="x => x.Details.PhoneNumber" Title="Numer Telefonu" />
                    <PropertyColumn Property="x => x.RoleName" Title="Rola" />
                    <PropertyColumn Property="x => x.CreatedAt" Title="Utworzono" />
                    <PropertyColumn Property="x => x.UpdatedAt" Title="Zaaktualizowano" />
                    <TemplateColumn Title="Akcje" StickyRight>
                        <CellTemplate>
                            <MudGrid>
                                <MudItem xs="6">
                                    <MudTooltip Placement="Placement.Bottom" Text="Edytuj użytkownika">
                                        <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => OpenEditDialogAsync(context.Item))" />
                                    </MudTooltip>
                                </MudItem>
                                <MudItem xs="6">
                                    <MudTooltip Placement="Placement.Bottom" Text="Dezaktywuj użytkownika">
                                        <MudIconButton Disabled="!context.Item.IsActive" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDeleteClicked(context.Item))" />
                                    </MudTooltip>
                                </MudItem>
                            </MudGrid>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>

                <PagerContent>
                    <MudDataGridPager T="UserResponseDto"
                                      RowsPerPageString="Wierszy na stronę"
                                      InfoFormat="{first_item}-{last_item} z {all_items}"
                                      PageSizeOptions="new int[] { 10, 15, 25, 50 }" />
                </PagerContent>
            </MudDataGrid>
        }
    }
</MudItem>

@if (TotalItems > 0)
{
    <MobileActionButton OnClick="OpenAddDialogAsync" />
}

@code {
    protected override async Task OnInitializedAsync() => await LoadDataAsync();
    protected override async Task LoadDataAsync()
    {
        try
        {
            IsLoading = true;
            var apiResponse = await UserService.GetAllUsersAsync(ShowInactive);
            if (apiResponse.Success)
            {
                Items = apiResponse.Data!.Items!;
                TotalItems = apiResponse.Data.TotalCount;
            }
            else
            {
                Snackbar.Add($"Błąd ładowania użytkowników: {apiResponse.Error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Błąd ładowania użytkowników: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Func<UserResponseDto, bool> _quickFilter => x =>
    {
        if (!ShowInactive && !x.IsActive)
            return false;
        if (string.IsNullOrWhiteSpace(SearchString))
            return true;
        if (x.Details.Name.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Details.Surname.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (x.Email.Contains(SearchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    };

    private Func<UserResponseDto, int, string> _rowStyleFunc => (x, i) =>
    {
        if (x.IsActive)
        {
            return "";
        }

        return "background-color: #f8d7da; color: #721c24;";
    };

    private async Task OpenAddDialogAsync()
    {
        var parameters = new DialogParameters<AddUserDialog>
            {
                { x => x.OnUserAdded, new EventCallback(this, LoadDataAsync) }
            };

        var dialogRef = await DialogService.ShowAsync<AddUserDialog>("Dodaj użytkownika", parameters, DialogHelper.GetStandardFormOptions());
        await dialogRef.Result;
    }


    private async Task OpenEditDialogAsync(UserResponseDto user)
    {
        var parameters = new DialogParameters<EditUserDialog>
        {
            { x => x.User, user },
            { x => x.OnUserUpdated, new EventCallback(this, LoadDataAsync)  }
        };

        var dialogRef = await DialogService.ShowAsync<EditUserDialog>("Edytuj użytkownika", parameters, DialogHelper.GetStandardFormOptions());
        await dialogRef.Result;
    }

    private async Task OnDeleteClicked(UserResponseDto user)
    {
        var parameters = new DialogParameters<ConfirmDialog>
    {
        { x => x.Title, "Dezaktywacja użytkownika" },
        { x => x.Content, $"Czy na pewno chcesz dezaktywować użytkownika {user.Details.Name} {user.Details.Surname}?" },
        { x => x.ConfirmText, "Dezaktywuj" },
        { x => x.Color, Color.Error },
        { x => x.Icon, Icons.Material.Filled.DeleteForever },
        { x => x.IconColor, Color.Error }
    };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Potwierdzenie", parameters, DialogHelper.GetConfirmationOptions());
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await DeactivateUser(user.Id);
        }
    }

    private async Task DeactivateUser(int id)
    {
        var response = await UserService.DeactivateUserAsync(id);
        if (response.Success)
        {
            Snackbar.Add("Użytkownik został dezaktywowany", Severity.Success);
            await LoadDataAsync();
        }
        else
        {
            Snackbar.Add(response.Error ?? "Błąd dezaktywacji", Severity.Error);
        }
    }
}