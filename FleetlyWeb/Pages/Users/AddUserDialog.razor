@inherits DialogBase<UserCreateDto>
@inject IUserService UserService

<MudDialog>
    <TitleContent>
        <MudText Style="font-weight:bold" Typo="Typo.h6">Dodaj użytkownika</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="Model" @ref="EditForm">
            <DataAnnotationsValidator />
            <UserForm T="UserCreateDto" Model="Model">
                <MudTextField @bind-Value="Model.Password" Label="Hasło" For="@(() => Model.Password)" 
                              InputType="InputType.Password" Variant="Variant.Outlined" Required />
            </UserForm>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="IsBusy" Color="Color.Default" Variant="Variant.Filled">Anuluj</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitForm" Disabled="IsBusy">
            @(IsBusy ? "Dodawanie..." : "Dodaj")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public EventCallback OnUserAdded { get; set; }

    protected override async Task Submit()
    {
        var res = await UserService.CreateUserAsync(Model);
        if (res.Success)
        {
            Snackbar.Add("Użytkownik dodany", Severity.Success);
            await OnUserAdded.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        else Snackbar.Add(res.Error ?? "Nie udało się dodać użytkownika", Severity.Error);
    }
}