@page "/home"
@attribute [Authorize]
@using FleetlyWeb.Services
@using FleetlyWeb.Services.Dashboard
@using Fleetly.Shared.Dto.DashboardDtos
@inject IDashboardService DashboardService
@inject ISnackbar Snackbar

<PageTitle>Panel główny</PageTitle>

<div>
    @if (_isAuthenticated)
    {
        <MudText Typo="Typo.h4">Witaj, @_fullName!</MudText>
        <MudText Typo="Typo.subtitle1">Twoja rola w systetmie to: @_userRole</MudText>
    }
    else
    {
        <MudSkeleton Width="300px" Height="40px" />
        <MudSkeleton Width="200px" Height="20px" />
    }
</div>

@if (_isLoading)
{
    <MudGrid>
        <MudItem xs="12" sm="6" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" /></MudItem>
        <MudItem xs="12" sm="6" md="3"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="100px" /></MudItem>
    </MudGrid>
}
else if (_stats != null)
{
    <MudGrid Class="mb-5">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center justify-center mud-theme-primary">
                <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Size="Size.Large" />
                <MudText Typo="Typo.h4">@_stats.ActiveOrdersCount</MudText>
                <MudText Typo="Typo.subtitle1">W realizacji</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center justify-center mud-theme-success">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" />
                <MudText Typo="Typo.h4">@_stats.CompletedOrdersCount</MudText>
                <MudText Typo="Typo.subtitle1">Zakończone</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center justify-center mud-theme-warning">
                <MudIcon Icon="@Icons.Material.Filled.AttachMoney" Size="Size.Large" />
                <MudText Typo="Typo.h4">@_stats.TotalRevenueMonth.ToString("N0") PLN</MudText>
                <MudText Typo="Typo.subtitle1">Obrót (Msc)</MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="3" Class="pa-4 d-flex flex-column align-center justify-center mud-theme-info">
                <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" />
                <MudText Typo="Typo.h4">@_stats.TotalClients</MudText>
                <MudText Typo="Typo.subtitle1">Klientów</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Elevation="3" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Przychody (ostatnie 6 msc)</MudText>
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="@_revenueSeries"
                          XAxisLabels="@_stats.RevenueMonthsLabels"
                          Width="100%" Height="350px"></MudChart>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Elevation="3" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Status Zleceń</MudText>
                <MudChart ChartType="ChartType.Donut"
                          InputData="@_stats.OrdersStatusData"
                          InputLabels="@_stats.OrdersStatusLabels"
                          Width="100%" Height="300px" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthStateTask { get; set; } = default!;

    private DashboardStatsDto? _stats;
    private List<ChartSeries> _revenueSeries = new();
    private bool _isLoading = true;
    private bool _isAuthenticated = false;

    private string _fullName = string.Empty;
    private string _userRole = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        await LoadStats();
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateTask;
        var user = authState.User;

        if (user.Identity is not null && user.Identity.IsAuthenticated)
        {
            _isAuthenticated = true;

            _fullName = user.FindFirst("FullName")?.Value ?? "Użytkowniku";
            _userRole = TranslateRole(user.FindFirst(ClaimTypes.Role)?.Value);
        }
    }

    private async Task LoadStats()
    {
        try
        {
            _isLoading = true;

            var response = await DashboardService.GetStatsAsync();
            if (response.Success && response.Data != null)
            {
                _stats = response.Data;
                _revenueSeries.Add(new ChartSeries()
                {
                    Name = "Przychód (PLN)",
                    Data = _stats.RevenueLast6Months
                });
            }
            else
            {
                Snackbar.Add("Nie udało się załadować statystyk.", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił błąd podczas ładowania statystyk.", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string TranslateRole(string? role)
    {
        return role switch
        {
            "Admin" => "Administrator",
            "Worker" => "Kierowca",
            "Client" => "Klient",
            _ => role ?? "Nieznana"
        };
    }
}
