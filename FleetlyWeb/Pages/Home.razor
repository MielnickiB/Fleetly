@page "/home"
@attribute [Authorize]
@using FleetlyWeb.Services
@inject IAuthService Auth
@inject NavigationManager Nav

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>
<MudButton Variant="Variant.Filled" OnClick="LogoutAsync" Disabled="_isLoggingOut">
    @if (_isLoggingOut)
    {
        <MudProgressCircular Size="Size.Small" Color="Color.Secondary" Indeterminate="true" />
    }
    else
    {
        <MudText Typo="Typo.button">Wyloguj się</MudText>
    }
</MudButton>

Welcome to your new app.

@code {
    private bool _isLoggingOut = false;

    async Task LogoutAsync()
    {
        _isLoggingOut = true;
        try
        {
            await Auth.Logout();
            Nav.NavigateTo("/", replace: true);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _isLoggingOut = false;
            StateHasChanged();
        }
    }
}
