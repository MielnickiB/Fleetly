@inherits LayoutComponentBase

<MudThemeProvider Theme="@FleetlyMobile.Theme.FleetlyTheme.Default" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="5" Color="Color.Primary" Dense="true">
        <MudText Typo="Typo.h5" Style="font-weight:bold">Fleetly</MudText>
    </MudAppBar>
    <MudMainContent>
        <MudContainer Class="d-flex align-center justify-center" Style="min-height:90vh" MaxWidth="MaxWidth.Small">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>