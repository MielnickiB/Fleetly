@inject NavigationManager Nav

<MudPaper Elevation="4" Class="d-flex justify-space-around align-center py-2 fixed-bottom mud-theme-surface" Style="position:fixed; bottom: 0; width: 100%; z-index: 1000;">

    <NavButton Icon="@Icons.Material.Filled.Home" Title="Pulpit" Path="/" ActiveColor="Color.Primary" OnClick="Navigate" CurrentPath="@currentPath" />

    <NavButton Icon="@Icons.Material.Filled.ListAlt" Title="Zlecenia" Path="/orders" ActiveColor="Color.Primary" OnClick="Navigate" CurrentPath="@currentPath" />

    <NavButton Icon="@Icons.Material.Filled.EventAvailable" Title="Dostępność" Path="/availability" ActiveColor="Color.Primary" OnClick="Navigate" CurrentPath="@currentPath" />

    <NavButton Icon="@Icons.Material.Filled.Person" Title="Profil" Path="/profile" ActiveColor="Color.Primary" OnClick="Navigate" CurrentPath="@currentPath" />

</MudPaper>

@code {
    private string currentPath = "/";

    protected override void OnInitialized()
    {
        currentPath = GetRelativePath();
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentPath = GetRelativePath();
        StateHasChanged();
    }

    private string GetRelativePath()
    {
        var uri = Nav.Uri.Replace(Nav.BaseUri, "/");
        if (uri.Length > 1 && uri.EndsWith("/")) return uri.Substring(0, uri.Length - 1);
        return uri;
    }

    private void Navigate(string path)
    {
        Nav.NavigateTo(path);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}