@inherits LayoutComponentBase
@inject LayoutService LayoutService
@implements IDisposable

<MudThemeProvider @ref="_mudThemeProvider"
                  Theme="@FleetlyMobile.Theme.FleetlyTheme.Default" 
                  IsDarkMode="@LayoutService.IsDarkMode" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Elevation="5" Color="Color.Primary" Dense="true">
        <MudText Typo="Typo.h5" Style="font-weight:bold">Fleetly</MudText>
        <MudSpacer />
        <NotificationMenu />
    </MudAppBar>

    <MudMainContent Class="pb-16">
        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
            @Body
        </MudContainer>
    </MudMainContent>

    <NavMenu />
</MudLayout>

@code {
    private MudThemeProvider _mudThemeProvider = default!;

    protected override void OnInitialized()
    {
        LayoutService.OnMajorUpdateOccurred += StateHasChanged;
        var savedMode = Preferences.Default.Get("is_dark_mode", false);
        LayoutService.SetDarkMode(savedMode);
    }

    public void Dispose()
    {
        LayoutService.OnMajorUpdateOccurred -= StateHasChanged;
    }
}