@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IAuthService AuthService

<MudThemeProvider Theme="@FleetlyMobile.Theme.FleetlyTheme.Default" />
<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <AuthorizeView>
        <Authorized>
            <MudAppBar Elevation="5" Color="Color.Primary" Dense="true">
                <MudText Typo="Typo.h5" Style="font-weight:bold">Fleetly</MudText>
                <MudSpacer />
                @*Do wyrzucenia*@
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="Logout" />
            </MudAppBar>

            <MudMainContent Class="pb-16">
                <MudContainer MaxWidth="MaxWidth.False" Class="mt-4">
                    @Body
                </MudContainer>
            </MudMainContent>

            <NavMenu />

        </Authorized>

        <NotAuthorized>
            <MudMainContent>
                <MudAppBar Elevation="5" Color="Color.Primary" Dense="true">
                    <MudText Typo="Typo.h5" Style="font-weight:bold">Fleetly</MudText>
                </MudAppBar>
                <MudContainer MaxWidth="MaxWidth.False" Class="d-flex align-center justify-center" Style="min-height:90vh">
                    @Body
                </MudContainer>
            </MudMainContent>
        </NotAuthorized>
    </AuthorizeView>
</MudLayout>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}