@page "/"
@using Microsoft.Maui.Media
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-4">
    <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">Protokół Oględzin</MudText>
    
    <MudPaper Elevation="4" Class="pa-4">
        <MudStack Spacing="4">
            <MudText Typo="Typo.body1">Krok 1: Lewa strona pojazdu</MudText>
            
            @if (photoPath != null)
            {
                <MudImage Src="@photoPath" Alt="Zdjęcie lewej strony" Elevation="2" Class="rounded-lg" Fluid="true" />
            }
            else
            {
                <MudAlert Severity="Severity.Info">Zrób zdjęcie lewej strony, aby kontynuować.</MudAlert>
            }

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.PhotoCamera" 
                       OnClick="TakePhoto"
                       FullWidth="true">
                Zrób Zdjęcie
            </MudButton>
            
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Success" 
                       Disabled="@(photoPath == null)"
                       FullWidth="true">
                Następny etap (Przód)
            </MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>

@code {
    private string? photoPath;

    private async Task TakePhoto()
    {
        // Usunięto sprawdzenie IsSupported, bo nie istnieje w IMediaPicker
        try
        {
            FileResult photo = await MediaPicker.Default.CapturePhotoAsync();

            if (photo != null)
            {
                string localFilePath = Path.Combine(FileSystem.CacheDirectory, photo.FileName);

                using Stream sourceStream = await photo.OpenReadAsync();
                using FileStream localFileStream = File.OpenWrite(localFilePath);

                await sourceStream.CopyToAsync(localFileStream);

                photoPath = localFilePath;
            }
        }
        catch (FeatureNotSupportedException)
        {
            // Obsługa przypadku, gdy urządzenie nie obsługuje aparatu
            // await DialogService.ShowMessageBox("To urządzenie nie obsługuje aparatu.");
        }
        catch (PermissionException)
        {
            // Obsługa braku uprawnień
            // await DialogService.ShowMessageAsync("Brak uprawnień do korzystania z aparatu.");
        }
        catch (Exception ex)
        {
            // Obsługa innych wyjątków
            // await DialogService.ShowMessageAsync($"Wystąpił błąd: {ex.Message}");
        }
    }
}