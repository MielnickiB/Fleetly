@page "/"
@attribute [Authorize(Roles = "Worker")]
@inject IDashboardService DashboardService
@inject AuthenticationStateProvider AuthStateProvider
@inherits BasePage

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
        @userName.FirstOrDefault()
    </MudAvatar>
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6" Style="font-weight:bold">Cześć, @userName!</MudText>
        <MudText Typo="Typo.caption">Miłego dnia w pracy!</MudText>
    </MudStack>
</MudStack>

@if (IsLoading)
{
    <Loading />
}
else if (data == null)
{
    <EmptyView OnRetry="LoadDataAsync" IsBusy="@IsLoading" />
}
else
{
    <MudStack Spacing="4" Class="pb-4">

        <MudText Typo="Typo.h6" Class="ml-1"><b>Dziś (@data.TodayOrders.Count)</b></MudText>
        @if (data.TodayOrders.Any())
        {
            @foreach (var order in data.TodayOrders)
            {
                <OrderCard Order="order" OnAction="OpenOrder" IsToday="true" />
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">Brak zleceń na dzisiaj.</MudText>
        }

        <MudText Typo="Typo.h6" Class="ml-1 mt-2"><b>Jutro (@data.TomorrowOrders.Count)</b></MudText>
        @if (data.TomorrowOrders.Any())
        {
            @foreach (var order in data.TomorrowOrders)
            {
                <OrderCard Order="order" OnAction="OpenOrder" IsToday="false" />
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">Brak zleceń na jutrzejszy dzień.</MudText>
        }

        <MudPaper Elevation="5" Class="pa-4 mt-2 rounded-lg" Style="background: var(--mud-palette-surface);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Szacowane wynagrodzenie</MudText>
                <MudToggleIconButton @bind-Toggled="showMoney"
                                     Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Default"
                                     ToggledIcon="@Icons.Material.Filled.Visibility" ToggledColor="Color.Primary" />
            </MudStack>

            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight: 800">
                @(showMoney ? $"{data.CurrentMonthSalary:N2} zł" : "••••••")
            </MudText>
            <MudText Typo="Typo.caption">Za bieżący miesiąc (@data.CompletedOrdersCount zleceń)</MudText>
        </MudPaper>

        <MudPaper Elevation="5" Class="pa-4 mt-2 rounded-lg" Style="background: var(--mud-palette-surface);">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Ilość wykonanych zleceń ogółem</MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 800" Color="Color.Success">@data.CompletedOrdersCount</MudText>
            <MudText Typo="Typo.caption">Dziękujemy Ci za twoją ciężką pracę!</MudText>
        </MudPaper>

    </MudStack>
}

@code {
    private string userName = string.Empty;
    private bool showMoney = true;
    private DriverDashboardDto? data;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        await ExecuteSafeAsync(LoadDataAsync);
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userName = authState.User.Identity?.Name ?? authState.User.FindFirst("FullName")?.Value ?? "Kierowco";
    }

    private async Task LoadDataAsync()
    {
        var response = await DashboardService.GetDashboardDataAsync();

        if (response.Success && response.Data != null)
        {
            data = response.Data;
        }
        else
        {
            throw new Exception(response.Error ?? "Nie udało się pobrać danych pulpitu.");
        }
    }

    private void OpenOrder(int id)
    {
        Nav.NavigateTo($"/orders/{id}");
    }
}