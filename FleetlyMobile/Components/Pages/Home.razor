@page "/"
@using Microsoft.AspNetCore.Authorization
@using Fleetly.Shared.Dto.DashboardDtos
@using Fleetly.Shared.Dto.OrderDtos
@using FleetlyMobile.Services.Dashboard
@using FleetlyMobile.Components.PagesComponents
@attribute [Authorize]
@inject AuthenticationStateProvider AuthStateProvider
@inject IDashboardService DashboardService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
        @userName.FirstOrDefault()
    </MudAvatar>
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6"><b>Cześć, @userName!</b></MudText>
        <MudText Typo="Typo.caption">Miłego dnia w pracy</MudText>
    </MudStack>
</MudStack>

@if (isLoading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="d-flex mx-auto mt-8" />
}
else if (data == null)
{
    <MudAlert Severity="Severity.Error">Nie udało się pobrać danych. Sprawdź połączenie.</MudAlert>
    <MudButton Variant="Variant.Outlined" OnClick="LoadData" Class="mt-2">Spróbuj ponownie</MudButton>
}
else
{
    <MudStack Spacing="4" Class="mb-16">

        <MudText Typo="Typo.h6" Class="ml-1"><b>Dziś (@data.TodayOrders.Count)</b></MudText>
        @if (data.TodayOrders.Any())
        {
            @foreach (var order in data.TodayOrders)
            {
                <OrderCard Order="order" OnClick="OpenOrder" IsToday="true"/>
            }
        }
        else
        {
             <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">Brak zleceń na dzisiaj.</MudText>
        }

        @if (data.TomorrowOrders.Any())
        {
            <MudText Typo="Typo.h6" Class="ml-1 mt-2"><b>Jutro (@data.TomorrowOrders.Count)</b></MudText>
            @foreach (var order in data.TomorrowOrders)
            {
                <OrderCard Order="order" OnClick="OpenOrder" IsToday="false"/>
            }
        }

        <MudPaper Elevation="0" Outlined="true" Class="pa-4 rounded-xl mt-2" Style="background: var(--mud-palette-surface);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Szacowane wynagrodzenie</MudText>
                <MudToggleIconButton @bind-Toggled="showMoney"
                                     Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Default"
                                     ToggledIcon="@Icons.Material.Filled.Visibility" ToggledColor="Color.Primary" />
            </MudStack>
            
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--mud-palette-success);">
                @(showMoney ? $"{data.CurrentMonthSalary:N2} zł" : "••••••")
            </MudText>
            <MudText Typo="Typo.caption">Za bieżący miesiąc (@data.CompletedOrdersCount zleceń)</MudText>
        </MudPaper>

    </MudStack>
}

@code {
    private string userName = "Kierowca";
    private bool isLoading = true;
    private bool showMoney = false;
    private DriverDashboardDto? data;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        await LoadData();
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userName = authState.User.Identity?.Name ?? authState.User.FindFirst("FullName")?.Value ?? "Kierowca";
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            var response = await DashboardService.GetDashboardDataAsync();
            if (response.Success && response.Data != null)
            {
                data = response.Data;
            }
            else
            {
                var errorMsg = $"Błąd {response.StatusCode}: {response.Error ?? "Brak szczegółów"}";
                Console.WriteLine(errorMsg);
                Snackbar.Add(errorMsg, Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Wystąpił błąd podczas pobierania danych. Sprawdź połączenie i spróbuj ponownie.", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenOrder(int id)
    {
        Nav.NavigateTo($"/orders/{id}");
    }
}