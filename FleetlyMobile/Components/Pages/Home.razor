@page "/"
@attribute [Authorize(Roles = "Worker")]
@inject IDashboardService DashboardService
@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthStateProvider
@inherits BasePage

<UserGreeting UserName="@userName" />

@if (IsLoading)
{
    <Loading />
}
else if (data == null)
{
    <EmptyView OnRetry="@(() => ExecuteSafeAsync(LoadDataAsync))" IsBusy="@IsLoading" />
}
else
{
    <MudStack Spacing="4" Class="pb-4">

        <MudText Typo="Typo.h6" Class="ml-1 fw-bold">Dziś (@data.TodayOrders.Count)</MudText>
        @if (data.TodayOrders.Any())
        {
            @foreach (var order in data.TodayOrders)
            {
                <OrderCard Order="order" OnAction="OpenOrder" IsToday="true" />
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">Brak zleceń na dzisiaj.</MudText>
        }

        @if (data.UpcomingOrders.Any())
        {
            var groups = data.UpcomingOrders.GroupBy(o => o.StartTime.Date).OrderBy(g => g.Key);

            @foreach (var group in groups)
            {
                var date = group.Key;
                var isTomorrow = date == DateTime.UtcNow.Date.AddDays(1);

                <MudText Typo="Typo.subtitle1" Class="ml-1 mt-2 fw-bold" Color="Color.Default">
                    @(isTomorrow ? "Jutro" : date.ToString("dddd, dd.MM", new CultureInfo("pl-PL")).ToUpper())
                    <span style="font-weight:normal; color:gray;">(@group.Count())</span>
                </MudText>

                @foreach (var order in group)
                {
                    var allowResign = !isTomorrow;
                    <OrderCard Order="order"
                               OnAction="OpenOrder"
                               OnResign="ResignOrder"
                               CanResign="@allowResign"
                               IsToday="false" />
                }
            }
        }
        else
        {
            <MudText Typo="Typo.body2" Class="pa-4" Color="Color.Secondary">Czysty kalendarz na najbliższy tydzień.</MudText>
        }

        <MudPaper Elevation="5" Class="pa-4 mt-2 rounded-lg" Style="background: var(--mud-palette-surface);">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Szacowane wynagrodzenie</MudText>
                <MudToggleIconButton @bind-Toggled="showMoney"
                                     Icon="@Icons.Material.Filled.VisibilityOff" Color="Color.Default"
                                     ToggledIcon="@Icons.Material.Filled.Visibility" ToggledColor="Color.Primary" />
            </MudStack>

            <MudText Typo="Typo.h4" Color="Color.Success" Style="font-weight: 800">
                @(showMoney ? $"{data.CurrentMonthSalary:N2} zł" : "••••••")
            </MudText>
            <MudText Typo="Typo.caption">Za bieżący miesiąc (@data.CompletedOrdersCount zleceń)</MudText>
        </MudPaper>

        <MudPaper Elevation="5" Class="pa-4 mt-2 rounded-lg" Style="background: var(--mud-palette-surface);">
            <MudText Typo="Typo.subtitle2" Color="Color.Secondary">Ilość wykonanych zleceń ogółem</MudText>
            <MudText Typo="Typo.h4" Style="font-weight: 800" Color="Color.Success">@data.CompletedOrdersCount</MudText>
            <MudText Typo="Typo.caption">Dziękujemy Ci za twoją ciężką pracę!</MudText>
        </MudPaper>

    </MudStack>
}

@code {
    private string userName = string.Empty;
    private bool showMoney = true;
    private DriverDashboardDto? data;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserData();
        await ExecuteSafeAsync(LoadDataAsync);
    }

    private async Task LoadUserData()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var fullName = authState.User.Identity?.Name ?? authState.User.FindFirst("FullName")?.Value ?? "Kierowco";

        var spaceIndex = fullName.IndexOf(' ');

        userName = spaceIndex > -1
            ? fullName.Substring(0, spaceIndex)
            : fullName;
    }

    private async Task LoadDataAsync()
    {
        var response = await DashboardService.GetDashboardDataAsync();

        if (response.Success && response.Data != null)
        {
            data = response.Data;
        }
        else
        {
            throw new Exception(response.Error ?? "Nie udało się pobrać danych pulpitu.");
        }
    }

    private async Task ResignOrder(int orderId)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Potwierdzenie", 
            "Czy na pewno chcesz zrezygnować z tego zlecenia?", 
            yesText: "Tak", cancelText: "Nie");

        if (confirmed == true)
        {
            await ExecuteSafeAsync(async () =>
            {
                var response = await OrderService.ResignOrderAsync(orderId);
                if (response.Success)
                {
                    await LoadDataAsync();
                    Snackbar.Add("Pomyślnie zrezygnowano ze zlecenia.", Severity.Success);
                }
                else
                {
                    throw new Exception(response.Error ?? "Nie udało się zrezygnować ze zlecenia.");
                }
            });
        }
    }

    private void OpenOrder(int id)
    {
        Nav.NavigateTo($"/orders/{id}");
    }
}