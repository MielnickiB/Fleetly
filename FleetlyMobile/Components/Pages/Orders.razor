@page "/orders"
@inject IOrderService OrderService
@inherits BaseListPage<OrderLiteDto>

<MudStack Spacing="4" Class="py-4">
    <MudText Typo="Typo.h5" Style="font-weight:bold">Giełda zleceń</MudText>
    <MudPaper Elevation="5" Class="pa-4 rounded-lg">
        <MudStack Spacing="4">
            <SearchInput Value="@SearchString" ValueChanged="OnSearch" Placeholder="Szukaj zleceń..." />
            <MudSelect T="string"
                       Label="Sortuj"
                       ValueChanged="HandleSortChange"
                       Adornment="Adornment.Start"
                       AdornmentIcon="@Icons.Material.Filled.Sort"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomLeft"
                       Margin="Margin.Dense"
                       Class="rounded-lg">
                <MudSelectItem Value="@("date_asc")">Najbliższy termin</MudSelectItem>
                <MudSelectItem Value="@("date_desc")">Najdalszy termin</MudSelectItem>
                <MudSelectItem Value="@("salary_desc")">Max wynagrodzenie</MudSelectItem>
                <MudSelectItem Value="@("salary_asc")">Min wynagrodzenie</MudSelectItem>
                <MudSelectItem Value="@("city_asc")">Miasta a-Z</MudSelectItem>
                <MudSelectItem Value="@("city_desc")">Miasta z-A</MudSelectItem>
            </MudSelect>
        </MudStack>
    </MudPaper>
    @if (IsLoading)
    {
        <Loading Height="50vh" />
    }
    else if (_isError)
    {
        <EmptyView OnRetry="LoadDataAsync" IsBusy="@IsLoading" />
    }
    else if (!Items.Any())
    {
        @if (!string.IsNullOrWhiteSpace(SearchString))
        {
            <EmptyView OnRetry="@(() => OnSearch(string.Empty))"
                       Title="Brak wyników"
                       Message=@($"Nie znaleziono zleceń dla frazy: \"{SearchString}\"")
                       Icon="@Icons.Material.Filled.SearchOff"
                       ButtonIcon="@Icons.Material.Filled.Clear"
                       ButtonText="Wyczyść filtry"
                       Height="50vh" />
        }
        else
        {
            <EmptyView OnRetry="LoadDataAsync"
                       Title="Brak dostępnych zleceń"
                       Message="Spróbuj ponownie później lub odśwież stronę."
                       Icon="@Icons.Material.Filled.Inbox"
                       ButtonIcon="@Icons.Material.Filled.RestartAlt"
                       ButtonText="Odśwież"
                       Height="50vh" />
        }
    }
    else
    {
        @foreach (var order in Items)
        {
            <OrderCard Order="order" IsProcessing="IsLoading" OnAction="AcceptOrder" CardType="OrderCardType.Marketplace" />
        }
    }
</MudStack>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
    <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="0">
        <MudSelect T="int"
                   Value="PageSize"
                   ValueChanged="OnPageSizeChanged"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Class="border-primary"
                   FitContent="true"
                   Dense="true">
            <MudSelectItem T="int" Value="5" />
            <MudSelectItem T="int" Value="10" />
            <MudSelectItem T="int" Value="20" />
        </MudSelect>

        @if (TotalItems == 0)
        {
            <MudText Typo="Typo.body2" Class="ml-2">
                Brak wyników
            </MudText>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="ml-2">
                @StartItem - @EndItem z @TotalItems
            </MudText>
        }

    </MudStack>
    <MudPagination Count="@TotalPages"
                   Selected="@CurrentPage"
                   SelectedChanged="OnPageChanged"
                   Color="Color.Primary"
                   ShowPageButtons="false"
                   Variant="Variant.Filled"
                   Size="Size.Medium" />
</MudStack>
@code {
    private bool _isError = false;

    protected override async Task LoadDataAsync()
    {
        _isError = false;

        var result = await OrderService.GetAllAvailableAsync(
            CurrentPage,
            PageSize,
            SearchString,
            SortBy,
            SortDescending);

        if (result.Success && result.Data != null)
        {
            Items = result.Data.Items;
            TotalItems = result.Data.TotalCount;
        }
        else
        {
            _isError = true;
            Items = new List<OrderLiteDto>();
            throw new Exception(result.Error ?? "Błąd pobierania danych");
        }
    }

    private async Task HandleSortChange(string value)
    {
        var parts = value.Split('_');
        var column = parts[0];
        var isDesc = parts[1] == "desc";

        await OnSortChanged(column, isDesc);
    }

    private async Task AcceptOrder(int orderId)
    {
        await ExecuteSafeAsync(async () =>
        {

            var result = await OrderService.AcceptOrderAsync(orderId);
            if (!result.Success)
            {
                throw new Exception(result.Error ?? "Błąd przyjmowania zlecenia");
            }

            await LoadDataAsync();

        }, successMessage: "Zlecenie przyjęte!");
    }
}