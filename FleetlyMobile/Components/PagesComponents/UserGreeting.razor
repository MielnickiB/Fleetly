<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
        @(string.IsNullOrEmpty(UserName) ? "Kierowco" : UserName.FirstOrDefault())
    </MudAvatar>
    <MudStack Spacing="0">
        <MudText Typo="Typo.h6" Style="font-weight:bold">Cześć, @UserName!</MudText>
        <MudText Typo="Typo.caption">@GreetingMessage</MudText>
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public string? UserName { get; set; }
    [Parameter]
    public string GreetingMessage { get; set; } = "Miłego dnia w pracy!";
}