<MudStack Spacing="0">
    <MudText Typo="Typo.caption" Color="Color.Secondary">@Title</MudText>
    <MudText Typo="Typo.body2">@Value</MudText>
</MudStack>

@code {
    [Parameter]
    public string Title { get; set; } = string.Empty;
    [Parameter]
    public string Value { get; set; } = string.Empty;
}
