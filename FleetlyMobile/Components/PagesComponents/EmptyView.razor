<MudStack AlignItems="AlignItems.Center"
          Justify="Justify.Center"
          Style=@($"height: {Height}")>
    <MudIcon Icon="@Icon" Size="@IconSize" Color="@IconColor" />

    <MudText Typo="Typo.h6" Align="Align.Center">@Title</MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">@Message</MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="HandleRetry"
               Disabled="@IsBusy"
               StartIcon="@ButtonIcon"
               Class="mt-2">
        <MudText Typo="Typo.button">@ButtonText</MudText>
    </MudButton>
</MudStack>

@code {
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public bool IsBusy { get; set; } = false;
    [Parameter] public string Title { get; set; } = "Brak połączenia";
    [Parameter] public string Message { get; set; } = "Nie udało się pobrać danych z serwera.";
    [Parameter] public string ButtonText { get; set; } = "Spróbuj ponownie";
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.CloudOff;
    [Parameter] public string ButtonIcon { get; set; } = Icons.Material.Filled.Refresh;
    [Parameter] public Size IconSize { get; set; } = Size.Large;
    [Parameter] public Color IconColor { get; set; } = Color.Error;
    [Parameter] public string Height { get; set; } = "70vh";

    private async Task HandleRetry()
    {
        if (OnRetry.HasDelegate)
            await OnRetry.InvokeAsync(null);
    }
}